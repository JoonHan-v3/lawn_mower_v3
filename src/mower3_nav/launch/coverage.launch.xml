<launch>
    <node pkg="mower3_bringup" exec="boundary_loader.py">
        <param name="use_sim_time" value="true"/>
        <param name="boundary_file" value="$(find-pkg-share mower3_bringup)/config/boundary.yaml"/>
    </node>

    <node pkg="mower3_bringup" exec="coverage_planner.py">
        <param name="use_sim_time" value="true"/>
        <param name="cutting_width" value="0.42"/>
        <param name="overlap" value="0.15"/>
        <param name="boundary_inset" value="0.5"/>
        <param name="point_spacing" value="0.2"/>
    </node>

    <node pkg="mower3_bringup" exec="coverage_executor.py">
        <param name="use_sim_time" value="true"/>
    </node>
</launch>
